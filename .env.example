VITE_GEMINI_API_KEY=your_gemini_api_key_here


# === SabPaisa Payment Gateway (iFrame / PG 3.0) ===
# Get these from your SabPaisa Dashboard
# Docs: https://devdocs.sabpaisa.in/iframe
# Contact: client.support@sabpaisa.in

# --- Server-side (used by server/index.js) ---
SP_MERCHANT_ID=YOUR_MERCHANT_ID
SP_API_KEY=YOUR_API_KEY
SP_SECRET_KEY=YOUR_SECRET_KEY

# "staging" or "production"
SP_ENV=staging

# Where SabPaisa redirects after payment (inside iframe, then breaks out)
SP_RETURN_URL=https://tracethem.online/payment/result

# Port for the payment backend server
PORT=3001

# --- Client-side (used by Vite frontend) ---
# URL of the payment backend (matches PORT above)
VITE_API_BASE=http://localhost:3001
